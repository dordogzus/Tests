<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MorePlayersMod</AssemblyName>
    <RootNamespace>MorePlayersMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>3.0.0</Version>
    <NoWarn>$(NoWarn);CS0162;CS0414;CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <!--
    Two build modes:
      * GameDir set and containing BepInEx interop -> compile against the player's real game.
      * otherwise                                   -> compile against ../../stubs (CI / no game).
    Stubs are compile-only and never shipped.
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(APPROXIMATELY_UP_DIR)</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <BepInExInterop>$(GameDir)\BepInEx\interop</BepInExInterop>
    <UseGameRefs Condition="'$(GameDir)' != '' And Exists('$(BepInExInterop)\Assembly-CSharp.dll')">true</UseGameRefs>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseGameRefs)' == 'true'">
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.Common.dll" Private="false" Condition="Exists('$(BepInExCore)\BepInEx.Unity.Common.dll')" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" Condition="Exists('$(BepInExCore)\Il2CppInterop.Common.dll')" />
    <Reference Include="$(BepInExInterop)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\Unity.Mathematics.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\Unity.Mathematics.Extensions.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\Unity.Entities.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\Unity.Collections.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\Unity.Transforms.dll" Private="false" />
    <Reference Include="$(BepInExInterop)\Unity.Physics.dll" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseGameRefs)' != 'true'">
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" PrivateAssets="all" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\stubs\Assembly-CSharp\Assembly-CSharp.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\Il2Cppmscorlib\Il2Cppmscorlib.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\UnityEngine.CoreModule\UnityEngine.CoreModule.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\UnityEngine.UIModule\UnityEngine.UIModule.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\UnityEngine.UI\UnityEngine.UI.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\UnityEngine.InputLegacyModule\UnityEngine.InputLegacyModule.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\UnityEngine.TextRenderingModule\UnityEngine.TextRenderingModule.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\Unity.Mathematics\Unity.Mathematics.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\Unity.Mathematics.Extensions\Unity.Mathematics.Extensions.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\Unity.Entities\Unity.Entities.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\Unity.Collections\Unity.Collections.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\Unity.Transforms\Unity.Transforms.csproj" Private="false" />
    <ProjectReference Include="..\..\stubs\Unity.Physics\Unity.Physics.csproj" Private="false" />
  </ItemGroup>

  <Target Name="DeployToPlugins" AfterTargets="Build" Condition="'$(DeployMod)' == 'true' And '$(UseGameRefs)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to BepInEx/plugins" />
  </Target>

</Project>
