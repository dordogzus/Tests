<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>KingdomEightCrowns</AssemblyName>
    <RootNamespace>KingdomEightCrowns</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(NuGetPackageRoot)il2cppinterop.runtime/$(Il2CppInteropVersion)/lib/net6.0/Il2CppInterop.Runtime.dll" Private="false" />
  </ItemGroup>
  <!-- Real interop assemblies from a game install (generated by BepInEx on first launch). -->
  <ItemGroup Condition="'$(KingdomInteropDir)' != ''">
    <Reference Include="Assembly-CSharp" HintPath="$(KingdomInteropDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(KingdomInteropDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(KingdomInteropDir)/Il2Cppmscorlib.dll" Private="false" />
  </ItemGroup>
  <!-- Otherwise compile against the committed signature stubs. -->
  <ItemGroup Condition="'$(KingdomInteropDir)' == ''">
    <ProjectReference Include="../../stubs/Assembly-CSharp/Assembly-CSharp.csproj" Private="false" />
    <ProjectReference Include="../../stubs/UnityEngine.CoreModule/UnityEngine.CoreModule.csproj" Private="false" />
    <ProjectReference Include="../../stubs/Il2Cppmscorlib/Il2Cppmscorlib.csproj" Private="false" />
  </ItemGroup>
</Project>
